generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  tags        String   // Comma-separated tags
  imageUrl    String
  projectUrl  String?
  githubUrl   String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  budget    String
  timeline  String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
